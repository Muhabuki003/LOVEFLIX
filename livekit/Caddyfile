{$DOMAIN} {
    # LiveKit signaling is WebSocket-based; Caddy proxies WS upgrades
    # automatically. "livekit-server" resolves on the docker-compose network.
    reverse_proxy livekit-server:7880 {
        header_up Host {host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    log {
        output stdout
    }
}
