# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# Public domain Caddy serves — clients connect to wss://<DOMAIN>.
# Must have DNS A/AAAA records pointing at this server; Caddy will
# provision the TLS certificate automatically.
DOMAIN=call.loveflix.so

# LiveKit API key pair. Generate a fresh pair with:
#   docker run --rm livekit/livekit-server generate-keys
# The SAME pair must be set as Cloudflare Pages secrets so the token
# endpoint signs tokens this server accepts:
#   wrangler pages secret put LIVEKIT_API_KEY
#   wrangler pages secret put LIVEKIT_API_SECRET
#   wrangler pages secret put LIVEKIT_URL     ← wss://<DOMAIN>
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
